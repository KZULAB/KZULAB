---
import { otherLang, routes, sectionHref, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Adresse de la même page dans l'autre langue (accueil de l'autre langue à défaut). */
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const alt = otherLang(lang);
const links = [
  { href: sectionHref(lang, 'projects'), label: t('nav.projects') },
  { href: sectionHref(lang, 'about'), label: t('nav.about') },
  { href: sectionHref(lang, 'contact'), label: t('nav.contact') },
];
const current = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="border-b-[1.5px] border-line">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={routes.home[lang]} class="text-[1.3rem] leading-none font-extrabold tracking-[0.02em] no-underline [font-stretch:125%]" aria-label={t('nav.home')}>
      KZULAB
    </a>
    <nav aria-label={t('nav.label')} class="hidden sm:block">
      <ul class="m-0 flex list-none p-0">
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.href === current ? 'page' : undefined} class="label inline-block border-l border-line-soft px-4 py-3 no-underline hover:bg-[var(--grid-strong)] aria-[current=page]:underline aria-[current=page]:underline-offset-4">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex gap-2">
      <a
        href={altHref}
        hreflang={alt}
        lang={alt}
        aria-label={`${t('lang.short')}, ${t('lang.switch')}`}
        class="label grid h-11 min-w-11 place-items-center border-[1.5px] border-line px-2 no-underline hover:bg-[var(--grid-strong)]"
      >{t('lang.short')}</a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t('theme.toggle')}
        class="grid size-11 cursor-pointer place-items-center border-[1.5px] border-line bg-transparent text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
  <nav aria-label={t('nav.label')} class="border-t border-line-soft sm:hidden">
    <ul class="m-0 grid list-none grid-cols-3 p-0">
      {links.map((l, i) => (
        <li class:list={[i > 0 && 'border-l border-line-soft']}>
          <a href={l.href} aria-current={l.href === current ? 'page' : undefined} class="label block px-1 py-3.5 text-center no-underline aria-[current=page]:underline aria-[current=page]:underline-offset-4">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('kz-theme', next);
    } catch {
      /* stockage indisponible : le choix vaut pour la page en cours */
    }
  });
</script>
