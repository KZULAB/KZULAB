---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
const links = [
  { href: '/#projets', label: t('nav.projects') },
  { href: '/#a-propos', label: t('nav.about') },
  { href: '/#contact', label: t('nav.contact') },
];
---

<header class="border-b-[1.5px] border-line">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="text-[1.3rem] leading-none font-extrabold tracking-[0.02em] no-underline [font-stretch:125%]" aria-label={t('nav.home')}>
      KZULAB
    </a>
    <nav aria-label={t('nav.label')} class="hidden sm:block">
      <ul class="m-0 flex list-none p-0">
        {links.map((l) => (
          <li><a href={l.href} class="label inline-block border-l border-line-soft px-4 py-3 no-underline hover:bg-[var(--grid-strong)]">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <button
      type="button"
      data-theme-toggle
      aria-label={t('theme.toggle')}
      class="grid size-11 cursor-pointer place-items-center border-[1.5px] border-line bg-transparent text-ink"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
  </div>
  <nav aria-label={t('nav.label')} class="border-t border-line-soft sm:hidden">
    <ul class="m-0 grid list-none grid-cols-3 p-0">
      {links.map((l, i) => (
        <li class:list={[i > 0 && 'border-l border-line-soft']}>
          <a href={l.href} class="label block px-2 py-3.5 text-center no-underline">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('kz-theme', next);
    } catch {
      /* stockage indisponible : le choix vaut pour la page en cours */
    }
  });
</script>
