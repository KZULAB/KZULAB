---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  figure: number;
  /** Absent = carte « Projet en préparation ». */
  project?: Project;
}
const { lang, figure, project } = Astro.props;
const t = useTranslations(lang);
---

{
  project ? (
    <article class:list={['fig', { linked: project.url }]} aria-labelledby={`fig-${figure}`}>
      <div class="fig-bar label">
        <span>{t('projects.fig')} {figure}</span>
        <span>{project.kind} · {project.platforms.join(' / ')}</span>
      </div>
      <div class="fig-body">
        {project.icon && (
          <div class="icon-frame">
            <Image src={project.icon.src} alt={project.icon.alt} width={118} height={118} densities={[1, 2]} loading="lazy" class="rounded-[26px]" />
          </div>
        )}
        <div>
          <h3 id={`fig-${figure}`} class="display mb-2.5 text-[2.1rem]">
            {project.url ? (
              <a class="card-link" href={project.url} rel="noopener">
                {project.name}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              project.name
            )}
          </h3>
          <p class="badge label">{t(`status.${project.status}`)}</p>
          <p class="m-0">{project.pitch}</p>
          {project.links && project.links.length > 0 && (
            <ul class="mt-4 flex list-none flex-wrap gap-3 p-0">
              {project.links.map((l) => (
                <li><a class="label relative z-[1] inline-block border-[1.5px] border-line px-3 py-2.5" href={l.url} rel="noopener">{l.label}</a></li>
              ))}
            </ul>
          )}
        </div>
      </div>
      <p class="fig-legend label">{t('projects.state')} : {t(project.status === 'available' ? 'status.available' : 'status.in-development')}</p>
    </article>
  ) : (
    <article class="fig todo" aria-labelledby={`fig-${figure}`}>
      <div class="fig-bar label">
        <span>{t('projects.fig')} {figure}</span>
        <span>{t('projects.upcoming')}</span>
      </div>
      <div class="hatch m-[22px] grid min-h-[200px] place-items-center border-[1.5px] border-dashed border-line-soft p-4 text-center">
        <h3 id={`fig-${figure}`} class="display bg-bg px-2.5 py-1.5 text-[1.4rem] leading-[1.1]">{t('projects.upcoming.title')}</h3>
      </div>
      <p class="fig-legend label">{t('projects.state')} : {t('projects.upcoming.state')}</p>
    </article>
  )
}

<style>
  .fig {
    border: 1.5px solid var(--line);
    background: var(--surface);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  /* Carte cliquable : le lien du titre s'étend à toute la carte. */
  .fig.linked {
    position: relative;
  }
  .fig.linked:hover {
    border-color: var(--mark);
  }
  .card-link {
    color: inherit;
    text-decoration: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .fig.linked:has(.card-link:focus-visible) {
    outline: 3px solid var(--mark);
    outline-offset: 3px;
  }
  .fig.linked:hover .card-link {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .arrow {
    margin-left: 0.3em;
    font-size: 0.6em;
    vertical-align: 0.3em;
    color: var(--mark);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fig.linked {
      transition:
        border-color 0.15s,
        transform 0.15s;
    }
    .fig.linked:hover {
      transform: translateY(-2px);
    }
  }
  .fig.todo {
    background: transparent;
  }
  .fig-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line-soft);
    color: var(--text-soft);
  }
  .fig-body {
    padding: 22px;
    display: grid;
    gap: 22px;
  }
  @media (min-width: 600px) {
    .fig-body {
      grid-template-columns: 150px 1fr;
    }
  }
  .icon-frame {
    width: 150px;
    height: 150px;
    border: 1px dashed var(--line-soft);
    display: grid;
    place-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid var(--mark);
    color: var(--mark);
    padding: 0.3rem 0.6rem;
    margin: 0 0 1rem;
  }
  .badge::before {
    content: '';
    width: 8px;
    height: 8px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .fig-legend {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--line-soft);
    color: var(--text-soft);
  }
</style>
